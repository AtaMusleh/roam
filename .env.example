DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional. Included in the User-Agent sent to Nominatim and Overpass, so an
# operator can reach you instead of blocking you. An email address or project URL.
NOMINATIM_CONTACT=

# Optional. Overpass instance used for landmark naming. Defaults to the public
# one at overpass-api.de, which is free but frequently saturated or down.
OVERPASS_ENDPOINT=

# Optional. Needed only to rebuild data/unsplash-rome.json, the committed
# photography cache for the demo trip. Register a free application at
# https://unsplash.com/developers. Seeding works without it from the cache.
UNSPLASH_ACCESS_KEY=

# Manual place editing. Off unless this is exactly "true", so a public
# deployment stays read-only and forgetting to set it fails closed.
ALLOW_EDITS=
NEXT_PUBLIC_GITHUB_URL=
