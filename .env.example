DATABASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional. Included in the User-Agent sent to Nominatim and Overpass, so an
# operator can reach you instead of blocking you. An email address or project URL.
NOMINATIM_CONTACT=

# Optional. Overpass instance used for landmark naming. Defaults to the public
# one at overpass-api.de, which is free but frequently saturated or down.
OVERPASS_ENDPOINT=

# Optional. Needed only to rebuild data/unsplash-rome.json, the committed
# photography cache for the demo trip. Register a free application at
# https://unsplash.com/developers. Seeding works without it from the cache.
UNSPLASH_ACCESS_KEY=

# The owner's password, for /admin. Editing is refused for everyone until this
# is set, so a deployment with no password is simply read-only.
ADMIN_PASSWORD=

# Signing key for the session cookie. At least 32 characters, and secret —
# anyone holding it can mint a session. Generate one with:
#   openssl rand -base64 24
# Changing it signs every outstanding session out, which is the way to revoke.
SESSION_SECRET=

# Local development override: "true" unlocks editing with no password, so the
# verification scripts do not need one. Ignored when NODE_ENV=production, since
# an all-or-nothing switch is exactly what the password gate replaces.
ALLOW_EDITS=

NEXT_PUBLIC_GITHUB_URL=
